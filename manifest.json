{
  "manifest_version": 3,
  "name": "Cslytics Float Curves",
  "description": "Shows Cslytics fair-price estimates and float curves on Steam's CS2 market and inventory pages.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://steamcommunity.com/market/listings/730/*",
    "https://steamcommunity.com/profiles/*/inventory*",
    "https://steamcommunity.com/id/*/inventory*",
    "https://steamcommunity.com/my/inventory*",
    "https://api.cslytics.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://steamcommunity.com/market/listings/730/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://steamcommunity.com/profiles/*/inventory*",
        "https://steamcommunity.com/id/*/inventory*",
        "https://steamcommunity.com/my/inventory*"
      ],
      "js": ["inventory-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://steamcommunity.com/profiles/*/inventory*",
        "https://steamcommunity.com/id/*/inventory*",
        "https://steamcommunity.com/my/inventory*"
      ],
      "js": ["inventory-page.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ]
}
