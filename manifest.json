{
  "manifest_version": 3,
  "name": "Cslytics Float Curves",
  "description": "Shows unified Normal, StatTrak, and available Souvenir fair-price curves on Steam's 2026 CS2 market pages.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://steamcommunity.com/market/listings/730/*",
    "https://api.cslytics.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://steamcommunity.com/market/listings/730/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
